# ---------------------------------------------------------------------------
# .htaccess ROOT PROYEK iTrust
#
# Tujuan: menutup berkas sensitif (.env, config, vendor, runtime, dump, dsb.)
# TANPA menolak seluruh path — supaya halaman error bawaan hosting
# (mis. /500.shtml) tetap bisa ditampilkan dan tidak muncul pesan
# "Additionally, a 403 Forbidden error was encountered while trying to use
# an ErrorDocument".
#
# Aman dipakai di hosting (document root = root proyek) maupun di Laragon
# (subfolder /OLD/itrust/) karena pola RewriteRule relatif terhadap folder ini.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Beranda proyek -> folder web/
    RewriteRule ^$ web/ [L]

    # 2) Berkas berawalan titik (.env, .git, .htaccess, …)
    #    /.well-known/ dikecualikan untuk verifikasi SSL.
    RewriteCond %{REQUEST_URI} !/\.well-known/
    RewriteRule (^|/)\. - [F,L]

    # 3) Ekstensi sensitif (dump/SQL/log/arsip)
    RewriteRule \.(env|sql|log|zip|md|lock|yml|yaml|neon|sh|ps1|bat|dist)$ - [F,L]

    # 4) Folder sumber & utilitas (tidak boleh diakses lewat web)
    RewriteRule ^(config|vendor|runtime|tests|scripts|mt5|example|mail|uploads|views|models|controllers|helpers|widgets|commands|assets)(/|$) - [F,L]

    # 5) Berkas utilitas di root
    RewriteRule ^(yii|yii\.bat|requirements\.php|codeception\.yml|composer\.(json|lock)|Vagrantfile|docker-compose\.yml|invoice\.code-workspace)$ - [F,L]
</IfModule>
