        "/ea/get-account-orders": {
            "get": {
                "tags": [
                    "EaController"
                ],
                "operationId": "get-account-orders",
                "summary": "Get open and closed orders for an account.",
                "description": "Fetch orders of the AccountOrders model split into open and closed\ngroups, with optional pagination, filtering and summary statistics.\n\nQuery parameters (GET or POST):\n- account_id  (required) The MT4/MT5 account number\n- limit       (optional) Number of orders per group, default 100\n- offset      (optional) Offset for pagination, default 0\n- symbol      (optional) Filter orders by symbol\n- from_date   (optional) Only orders opened at/after this date (Y-m-d)\n- to_date     (optional) Only orders opened up to this date (Y-m-d)\n- with_stats  (optional) 1 to include computed statistics",
                "parameters": [
                    {
                        "name": "account_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "symbol",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "from_date",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "to_date",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "with_stats",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
