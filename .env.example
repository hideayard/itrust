# Salin berkas ini menjadi `.env` di ROOT PROYEK (sebelah folder web/, bukan di dalam web/).
# File .env dimuat otomatis oleh web/index.php — TIDAK perlu SetEnv di .htaccess.

# --- Mode aplikasi ---
# 'prod' mematikan debugger (yii\debug), gii, dan log $_POST/$_SERVER tiap request.
YII_ENV=prod
YII_DEBUG=false

# --- Database modul ERP (/erp/api/v1) ---
# Di cPanel nama database/user biasanya ber-prefix akun.
AUREUS_DB_HOST=localhost
AUREUS_DB=<akun>_itrust_erp
AUREUS_DB_USER=<akun>_erp
AUREUS_DB_PASSWORD=rahasia

AUREUS_CORS_ORIGINS=https://itrust-erp.pages.dev
AUREUS_TOKEN_TTL_DAYS=90

# --- Database aplikasi iTrust ---
# Tetap diatur di config/db.php (berkas PHP, di-gitignore).
# Bila ingin juga lewat .env, lihat langkah opsional di DEPLOY-ITRUST-HOSTING.md §5.1.
